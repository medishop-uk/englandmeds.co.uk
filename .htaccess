Options -Indexes
RewriteEngine On

# Force the production hostname only when the request is already for EnglandMeds.
# Explicitly exclude XAMPP development hosts so the project subdirectory is
# never appended to the live domain.
RewriteCond %{HTTP_HOST} !^(?:localhost|127\.0\.0\.1)(?::[0-9]+)?$ [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?englandmeds\.co\.uk$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.englandmeds\.co\.uk$ [NC]
RewriteRule ^ https://www.englandmeds.co.uk%{REQUEST_URI} [R=301,L,NE]

# Public URLs never expose index.html or .html.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
RewriteRule ^ %{REQUEST_SCHEME}://%{HTTP_HOST}/%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
RewriteRule ^ %{REQUEST_SCHEME}://%{HTTP_HOST}/%1 [R=301,L,NE]

# Legacy utility routes.
RedirectMatch 301 ^/(search|user/profile|test-header)/?$ https://www.englandmeds.co.uk/
RedirectMatch 301 ^/(terms-and-conditions|privacy-policy|contact-us)/?$ https://www.englandmeds.co.uk/about-us/
RedirectMatch 301 ^/service-area/?$ https://www.englandmeds.co.uk/

# Legacy paths whose slugs changed.
Redirect 301 /service-area/online-pharmacy-in-leed https://www.englandmeds.co.uk/service-area/best-online-pharmacy-in-leeds
