Options -Indexes

RewriteEngine On

# =====================================================
# CANONICAL REDIRECT — PRODUCTION DOMAIN ONLY
# localhost will NOT be redirected
# =====================================================

RewriteCond %{HTTP_HOST} ^(?:www\.)?englandmeds\.co\.uk$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.englandmeds\.co\.uk$ [NC]
RewriteRule ^ https://www.englandmeds.co.uk%{REQUEST_URI} [R=301,L,NE]

# Removed utility/account/legal routes.
RedirectMatch 301 ^/(search|user/profile|test-header)/?$ https://www.englandmeds.co.uk/
RedirectMatch 301 ^/(terms-and-conditions|privacy-policy|contact-us)/?$ https://www.englandmeds.co.uk/about-us/
RedirectMatch 301 ^/service-area/?$ https://www.englandmeds.co.uk/
RedirectMatch 301 ^/shop/category/.*$ https://www.englandmeds.co.uk/shop/

